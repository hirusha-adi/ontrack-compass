{
  "manifest_version": 3,
  "name": "OnTrack Compass",
  "version": "1.0.0",
  "description": "Dashboard for OnTrack tasks, time estimates, and local todos.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ontrack-compass@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://ontrack.deakin.edu.au/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Open OnTrack Compass",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://ontrack.deakin.edu.au/*"],
      "js": ["content/auth-capture.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/page-bridge.js"],
      "matches": ["https://ontrack.deakin.edu.au/*"]
    }
  ]
}
